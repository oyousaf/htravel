---
import { site } from "../data/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3", className]}>
  <a
    href={site.emailHref}
    aria-label="Email us"
    class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white hover:bg-teal hover:text-navy-dark transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </svg>
  </a>

  <a
    href={site.social.facebook}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Follow us on Facebook"
    class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white hover:bg-teal hover:text-navy-dark transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2Z" />
    </svg>
  </a>

  <a
    href={site.social.tiktok}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Follow us on TikTok"
    class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white hover:bg-teal hover:text-navy-dark transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
      <path d="M16.6 5.82c-1.02-.9-1.6-2.18-1.6-3.6V2h-3.15v13.6a2.59 2.59 0 0 1-2.59 2.5A2.6 2.6 0 0 1 6.66 15.5c0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64C3.56 18.63 6.32 21 9.25 21c3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-2.64-1.48Z" />
    </svg>
  </a>
</div>
