---
import { offers } from "../data/offers";

const themes = {
  green: "from-[#14402c] to-[#0b2619]",
  brown: "from-[#4a2c17] to-[#29180c]",
  maroon: "from-[#561634] to-[#300b1d]",
};
---

<div class="mt-16">
  <div class="text-center mb-8" data-animate>
    <h3 class="text-2xl sm:text-3xl font-bold text-white">In-Store Offers</h3>
    <p class="text-white/60 mt-2">Pick them up at our Oldfield Lane shop.</p>
  </div>
  <div class="grid md:grid-cols-3 gap-6" data-animate-group>
    {
      offers.map((o) => (
        <article
          data-animate
          class:list={[
            "relative isolate overflow-hidden rounded-2xl border border-amber-300/25 bg-linear-to-br p-6 flex flex-col gap-4",
            themes[o.theme],
          ]}
        >
          <img
            src={o.image}
            alt=""
            loading="lazy"
            class="absolute inset-y-0 right-0 -z-10 h-full w-3/4 object-cover opacity-35"
            style="mask-image: linear-gradient(to left, black 20%, transparent); -webkit-mask-image: linear-gradient(to left, black 20%, transparent);"
          />
          <h4 class="text-xl font-bold text-amber-200">{o.title}</h4>
          <ul class="flex-1 divide-y divide-white/10">
            {o.items.map((i) => (
              <li class="flex items-baseline justify-between gap-4 py-2">
                <span class="text-white/85">{i.label}</span>
                <span class="whitespace-nowrap">
                  <span class="text-amber-300 text-2xl font-bold">{i.price}</span>
                  {i.unit && <span class="text-white/60 text-sm"> {i.unit}</span>}
                </span>
              </li>
            ))}
          </ul>
          {o.deal && (
            <p class="rounded-full bg-black/25 px-4 py-1.5 text-center text-sm font-semibold text-amber-100">
              {o.deal}
            </p>
          )}
        </article>
      ))
    }
  </div>
</div>
