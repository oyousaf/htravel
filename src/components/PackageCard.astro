---
import type { PackageTier } from "../data/hajjUmrah";

interface Props {
  pkg: PackageTier;
}

const { pkg } = Astro.props;
---

<div
  data-animate
  class:list={[
    "rounded-2xl p-6 sm:p-8 flex flex-col gap-4 border transition-transform hover:-translate-y-1",
    pkg.featured
      ? "bg-navy-light border-teal shadow-lg shadow-teal/10"
      : "bg-navy-light/50 border-white/10",
  ]}
>
  {pkg.featured && (
    <span class="self-start rounded-full bg-teal px-3 py-1 text-xs font-semibold text-navy-dark">
      Most Popular
    </span>
  )}
  <h3 class="text-xl font-bold text-white">{pkg.name}</h3>
  <p class="text-teal text-2xl font-bold">{pkg.price}</p>
  <p class="text-white/50 text-sm">{pkg.duration}</p>
  <ul class="flex-1 space-y-2 text-sm text-white/70">
    {
      pkg.features.map((f) => (
        <li class="flex items-start gap-2">
          <span class="text-teal mt-0.5">✓</span>
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <a
    href="/contact"
    class:list={[
      "mt-2 inline-flex justify-center rounded-full px-5 py-2.5 text-sm font-semibold transition-colors",
      pkg.featured
        ? "bg-teal text-navy-dark hover:bg-teal-dark"
        : "bg-white/10 text-white hover:bg-white/20",
    ]}
  >
    Enquire Now
  </a>
</div>
