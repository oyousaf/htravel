---
import { octoberUmrah as p } from "../data/hajjUmrah";
import { site } from "../data/site";
---

<article
  data-animate
  class="rounded-3xl border border-teal bg-navy-light shadow-lg shadow-teal/10 p-6 sm:p-10 flex flex-col gap-8"
>
  <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <span class="inline-block rounded-full bg-teal px-3 py-1 text-xs font-semibold text-navy-dark mb-3">
        {p.nights} nights · {p.dates}
      </span>
      <h3 class="text-2xl sm:text-3xl font-bold text-white">{p.name}</h3>
      <p class="text-white/70 mt-1">Led by <span class="text-white font-semibold">{p.leader}</span></p>
    </div>
    <p class="text-white/60 text-sm">
      Book now with just <span class="text-teal font-bold text-lg">{p.deposit}</span>
      <span class="block text-xs text-white/55">non-refundable deposit</span>
    </p>
  </header>

  <div class="grid md:grid-cols-2 gap-4">
    {
      p.hotels.map((h) => (
        <div class="rounded-2xl bg-navy-dark/60 border border-white/10 p-5">
          <p class="text-teal text-xs font-semibold uppercase tracking-wide">{h.city} · {h.nights} nights</p>
          <p class="text-white font-bold text-lg mt-1">
            {h.name} <span class="text-amber-300 text-sm" aria-label={`${h.stars} star`}>{"★".repeat(h.stars)}</span>
          </p>
          <p class="text-white/60 text-sm mt-1">{h.board} · Check-in {h.checkIn} · Check-out {h.checkOut}</p>
        </div>
      ))
    }
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    <div>
      <h4 class="text-white font-semibold mb-3">Price per person</h4>
      <ul class="divide-y divide-white/10 rounded-2xl border border-white/10 overflow-hidden">
        {
          p.rooms.map((r) => (
            <li class="flex items-center justify-between px-5 py-3 bg-navy-dark/40">
              <span class="text-white/80">{r.label}</span>
              <span class="text-teal text-xl font-bold">{r.price}</span>
            </li>
          ))
        }
      </ul>
      <ul class="mt-3 space-y-1 text-sm text-white/60">
        <li>Youth &amp; child price: {p.youthChildDiscount} less</li>
        <li>Prices valid for British passports — other nationalities {p.nonBritishSurcharge} extra</li>
      </ul>
    </div>

    <div class="flex flex-col gap-6">
      <div>
        <h4 class="text-white font-semibold mb-3">Included</h4>
        <ul class="flex flex-wrap gap-2">
          {p.includes.map((i) => (
            <li class="rounded-full bg-white/10 px-3 py-1 text-sm text-white/80">✓ {i}</li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-3">Transport</h4>
        <ul class="space-y-1 text-sm text-white/70">
          {p.transport.map((t) => <li>• {t}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div>
    <h4 class="text-white font-semibold mb-3">Flights ({p.airline})</h4>
    <ul class="grid md:grid-cols-3 gap-3">
      {
        p.flights.map((f) => (
          <li class="rounded-2xl bg-navy-dark/60 border border-white/10 p-4 text-sm">
            <p class="flex justify-between text-white/55 text-xs">
              <span>{f.date}</span>
              <span class="font-mono">{f.flight}</span>
            </p>
            <p class="text-white mt-2">
              {f.from} <span class="text-white/55">{f.departs}</span>
            </p>
            <p class="text-white">
              → {f.to} <span class="text-white/55">{f.arrives}</span>
            </p>
            <p class="text-white/55 text-xs mt-1">{f.duration}</p>
          </li>
        ))
      }
    </ul>
    <p class="text-white/55 text-xs mt-2">Local times shown. Return connects in Jeddah (3h 10m transit).</p>
  </div>

  <div class="flex flex-wrap gap-3">
    <a
      href={site.mobileHref}
      class="inline-flex rounded-full bg-teal px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
    >
      Book on {site.mobile}
    </a>
    <a
      href="/contact"
      class="inline-flex rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-colors"
    >
      Send an Enquiry
    </a>
  </div>
</article>
