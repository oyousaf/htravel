---
// Logos are displayed as an authorised agent. Swap for each provider's official
// agent-kit artwork if they supply it.
---

<div data-animate class="mt-10 flex flex-col items-center gap-4">
  <p class="text-white/60 text-sm">Send money abroad with our trusted partners</p>
  <ul class="flex flex-wrap justify-center items-center gap-4">
    <li class="flex h-14 items-center rounded-xl bg-[#FFDD00] px-5">
      <span class="flex items-center gap-2 text-black">
        <svg role="img" aria-label="Western Union" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
          <path d="M15.799 5.188h5.916L24 9.155l-4.643 8.043c-1.246 2.153-3.28 2.153-4.526 0L7.893 5.188h5.919l4.273 7.39a1.127 1.127 0 0 0 1.981.002l-4.267-7.392ZM0 5.188h5.921l6.237 10.802-.697 1.204c-1.246 2.153-3.285 2.153-4.531 0L0 5.188Z" />
        </svg>
        <span aria-hidden="true" class="text-sm font-extrabold uppercase tracking-tight leading-none">
          Western<br />Union
        </span>
      </span>
    </li>
    <li class="flex h-14 items-center rounded-xl bg-white px-5">
      <img src="/images/partners/ria.svg" alt="Ria Money Transfer" class="h-9 w-auto" loading="lazy" />
    </li>
    <li class="flex h-14 items-center rounded-xl bg-white px-5">
      <img src="/images/partners/intercity.png" alt="Intercity Money" class="h-7 w-auto" loading="lazy" />
    </li>
  </ul>
</div>
