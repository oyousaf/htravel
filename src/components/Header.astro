---
import { site } from "../data/site";
import BrandMark from "./BrandMark.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-navy-dark/90 backdrop-blur border-b border-white/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" id="brand-home-link" class="shrink-0">
      <BrandMark class="hover:bg-teal-dark transition-colors" />
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-teal",
              currentPath === item.href ? "text-teal" : "text-white/80",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.phoneHref}
      class="hidden sm:inline-flex items-center rounded-full bg-teal px-4 py-2 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
    >
      Call {site.phone}
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden relative z-50 h-6 w-6 shrink-0"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span
        id="hamburger-bar-1"
        class="absolute left-0 top-1 h-0.5 w-6 rounded-full bg-white transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
      ></span>
      <span
        id="hamburger-bar-2"
        class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 w-6 rounded-full bg-white transition-opacity duration-200 ease-out"
      ></span>
      <span
        id="hamburger-bar-3"
        class="absolute left-0 bottom-1 h-0.5 w-6 rounded-full bg-white transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
      ></span>
    </button>
  </div>
</header>

<div
  id="mobile-menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  class="md:hidden fixed inset-0 z-40 bg-navy-dark/98 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-400 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <nav class="h-full flex flex-col items-center justify-center gap-1 px-6">
    {
      site.nav.map((item, i) => (
        <a
          href={item.href}
          class="mobile-nav-item text-3xl font-bold text-white/90 hover:text-teal transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 translate-y-6 py-2"
          style={`transition-delay: ${i * 60}ms`}
        >
          {item.label}
        </a>
      ))
    }
    <div
      class="mobile-nav-item opacity-0 translate-y-6 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] mt-8 flex flex-col items-center gap-4"
      style={`transition-delay: ${site.nav.length * 60}ms`}
    >
      <a
        href={site.phoneHref}
        class="rounded-full bg-teal px-8 py-3 text-base font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
      >
        Call {site.phone}
      </a>
      <a
        href={site.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="text-teal font-medium hover:text-teal-dark transition-colors"
      >
        Chat on WhatsApp
      </a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const overlay = document.getElementById("mobile-menu-overlay");
  const items = document.querySelectorAll<HTMLElement>(".mobile-nav-item");
  const bar1 = document.getElementById("hamburger-bar-1");
  const bar2 = document.getElementById("hamburger-bar-2");
  const bar3 = document.getElementById("hamburger-bar-3");
  let isOpen = false;

  function getFocusable(): HTMLElement[] {
    return Array.from(overlay?.querySelectorAll<HTMLElement>("a[href]") ?? []);
  }

  function setMenuOpen(open: boolean) {
    isOpen = open;
    toggle?.setAttribute("aria-expanded", String(open));

    overlay?.classList.toggle("opacity-0", !open);
    overlay?.classList.toggle("pointer-events-none", !open);
    overlay?.toggleAttribute("inert", !open);

    items.forEach((item) => {
      item.classList.toggle("opacity-0", !open);
      item.classList.toggle("translate-y-6", !open);
    });

    bar1?.style.setProperty("transform", open ? "translateY(7px) rotate(45deg)" : "none");
    bar3?.style.setProperty("transform", open ? "translateY(-7px) rotate(-45deg)" : "none");
    bar2?.classList.toggle("opacity-0", open);

    document.documentElement.style.overflow = open ? "hidden" : "";

    if (open) {
      getFocusable()[0]?.focus();
    } else {
      toggle?.focus();
    }
  }

  toggle?.addEventListener("click", () => setMenuOpen(!isOpen));

  document.querySelectorAll(".mobile-nav-item a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (!isOpen) return;

    if (e.key === "Escape") {
      setMenuOpen(false);
      return;
    }

    if (e.key === "Tab") {
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  const brandLink = document.getElementById("brand-home-link");
  brandLink?.addEventListener("click", (e) => {
    if (window.location.pathname === "/") {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>
