---
import { site } from "../data/site";
import BrandMark from "./BrandMark.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-navy-dark/90 backdrop-blur border-b border-white/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" id="brand-home-link" class="shrink-0">
      <BrandMark class="hover:bg-teal-dark transition-colors" />
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition-colors hover:text-teal",
              currentPath === item.href ? "text-teal" : "text-white/80",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.phoneHref}
      class="hidden sm:inline-flex items-center rounded-full bg-teal px-4 py-2 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
    >
      Call {site.phone}
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden text-white p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-white/10 px-4 py-3 flex-col gap-3 text-sm font-medium">
    {
      site.nav.map((item) => (
        <a href={item.href} class="text-white/80 hover:text-teal transition-colors">
          {item.label}
        </a>
      ))
    }
    <a href={site.phoneHref} class="text-teal font-semibold">
      Call {site.phone}
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });

  const brandLink = document.getElementById("brand-home-link");
  brandLink?.addEventListener("click", (e) => {
    if (window.location.pathname === "/") {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>
