---
import { site } from "../data/site";
import BrandMark from "./BrandMark.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-navy-dark/90 backdrop-blur border-b border-white/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" id="brand-home-link" class="shrink-0">
      <BrandMark class="hover:bg-teal-dark transition-colors" />
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition-colors hover:text-teal",
              currentPath === item.href ? "text-teal" : "text-white/80",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.phoneHref}
      class="hidden sm:inline-flex items-center rounded-full bg-teal px-4 py-2 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
    >
      Call {site.phone}
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden relative h-6 w-6 shrink-0"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span
        id="hamburger-bar-1"
        class="absolute left-0 top-1 h-0.5 w-6 rounded-full bg-white transition-transform duration-300 ease-out"
      ></span>
      <span
        id="hamburger-bar-2"
        class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 w-6 rounded-full bg-white transition-opacity duration-200 ease-out"
      ></span>
      <span
        id="hamburger-bar-3"
        class="absolute left-0 bottom-1 h-0.5 w-6 rounded-full bg-white transition-transform duration-300 ease-out"
      ></span>
    </button>
  </div>

  <div
    id="mobile-menu-wrapper"
    class="md:hidden grid transition-[grid-template-rows] duration-300 ease-out"
    style="grid-template-rows: 0fr;"
  >
    <nav id="mobile-menu" class="overflow-hidden">
      <div
        id="mobile-menu-inner"
        class="border-t border-white/10 px-4 py-3 flex flex-col gap-3 text-sm font-medium opacity-0 -translate-y-2 transition-all duration-300 ease-out"
      >
        {
          site.nav.map((item) => (
            <a href={item.href} class="text-white/80 hover:text-teal transition-colors">
              {item.label}
            </a>
          ))
        }
        <a href={site.phoneHref} class="text-teal font-semibold">
          Call {site.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const wrapper = document.getElementById("mobile-menu-wrapper");
  const inner = document.getElementById("mobile-menu-inner");
  const bar1 = document.getElementById("hamburger-bar-1");
  const bar2 = document.getElementById("hamburger-bar-2");
  const bar3 = document.getElementById("hamburger-bar-3");
  let isOpen = false;

  function setMenuOpen(open: boolean) {
    isOpen = open;
    toggle?.setAttribute("aria-expanded", String(open));

    if (wrapper) wrapper.style.gridTemplateRows = open ? "1fr" : "0fr";

    inner?.classList.toggle("opacity-0", !open);
    inner?.classList.toggle("-translate-y-2", !open);

    bar1?.style.setProperty("transform", open ? "translateY(7px) rotate(45deg)" : "none");
    bar3?.style.setProperty("transform", open ? "translateY(-7px) rotate(-45deg)" : "none");
    bar2?.classList.toggle("opacity-0", open);
  }

  toggle?.addEventListener("click", () => setMenuOpen(!isOpen));

  const brandLink = document.getElementById("brand-home-link");
  brandLink?.addEventListener("click", (e) => {
    if (window.location.pathname === "/") {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>
