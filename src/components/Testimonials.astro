---
import { testimonials, googleRating, googleReviewCount, googleMapsUrl } from "../data/testimonials";

const stars = Array.from({ length: 5 });
---

<div>
  <div class="flex items-center gap-3 mb-10" data-animate>
    <div class="flex text-teal">
      {
        stars.map((_, i) => (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
            <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z" />
          </svg>
        ))
      }
    </div>
    <p class="text-white font-semibold">{googleRating} out of 5</p>
    <a
      href={googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-white/50 text-sm hover:text-teal transition-colors"
    >
      from {googleReviewCount} Google reviews
    </a>
  </div>

  <div class="grid sm:grid-cols-2 gap-6">
    {
      testimonials.map((t) => (
        <div data-animate class="rounded-2xl bg-navy-light/50 border border-white/10 p-6 flex flex-col gap-4">
          <div class="flex text-teal">
            {stars.map((_, i) => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z" />
              </svg>
            ))}
          </div>
          <p class="text-white/80 text-sm leading-relaxed">"{t.quote}"</p>
          <p class="text-white/55 text-xs mt-auto">Google Review{t.context ? ` · ${t.context}` : ""}</p>
        </div>
      ))
    }
  </div>
</div>
