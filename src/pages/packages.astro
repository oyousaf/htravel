---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import PackageCard from "../components/PackageCard.astro";
import { umrahPackages, hajjPackages } from "../data/hajjUmrah";
import { site } from "../data/site";
---

<Layout
  title="Hajj & Umrah Packages"
  description="Hajj and Umrah packages from Heckmondwike Travel & Tours — flights, hotels, transfers and visa processing included."
>
  <section class="bg-navy pt-16 pb-12 sm:pt-24 sm:pb-16 px-4 sm:px-6 text-center">
    <div data-animate-group>
      <p data-animate class="text-teal font-semibold uppercase text-sm tracking-wide mb-3">
        Sacred Journeys
      </p>
      <h1 data-animate class="text-4xl sm:text-5xl font-extrabold text-white mb-4">
        Hajj & Umrah Packages
      </h1>
      <p data-animate class="text-white/70 max-w-2xl mx-auto">
        Flights, accommodation, transfers, and visa processing — all arranged by an experienced
        team that has guided pilgrims from West Yorkshire for years.
      </p>
    </div>
  </section>

  <Section>
    <h2 data-animate class="text-2xl sm:text-3xl font-bold text-white mb-8">Umrah Packages</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {umrahPackages.map((pkg) => <PackageCard pkg={pkg} />)}
    </div>
  </Section>

  <Section class="bg-navy-light/30">
    <h2 data-animate class="text-2xl sm:text-3xl font-bold text-white mb-8">Hajj Packages</h2>
    <div class="grid sm:grid-cols-2 gap-6 max-w-4xl">
      {hajjPackages.map((pkg) => <PackageCard pkg={pkg} />)}
    </div>
  </Section>

  <Section>
    <div data-animate class="rounded-3xl bg-navy-light border border-white/10 px-6 sm:px-12 py-10 sm:py-14 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Not Sure Which Package Fits?</h2>
      <p class="text-white/70 max-w-xl mx-auto mb-8">
        Every group and family is different. Speak to our team and we'll put together a package
        and payment plan around your needs.
      </p>
      <a
        href={site.phoneHref}
        class="inline-flex rounded-full bg-teal px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
      >
        Call {site.phone}
      </a>
    </div>
  </Section>
</Layout>
