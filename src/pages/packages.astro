---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import HajjDeadline from "../components/HajjDeadline.astro";
import OctoberUmrahPackage from "../components/OctoberUmrahPackage.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Hajj2027Packages from "../components/Hajj2027Packages.astro";
import { site } from "../data/site";
import { octoberUmrah, hajj2027 } from "../data/hajjUmrah";
---

<Layout
  title="Hajj & Umrah Packages"
  description="Hajj and Umrah packages from Heckmondwike Travel & Tours — flights, hotels, transfers and visa processing included."
>
  <section class="bg-navy pt-16 pb-12 sm:pt-24 sm:pb-16 px-4 sm:px-6 text-center">
    <div data-animate-group>
      <p data-animate class="text-teal font-semibold uppercase text-sm tracking-wide mb-3">
        Sacred Journeys
      </p>
      <h1 data-animate class="text-4xl sm:text-5xl font-extrabold text-white mb-4">
        Hajj & Umrah Packages
      </h1>
      <p data-animate class="text-white/70 max-w-2xl mx-auto">
        Flights, accommodation, transfers, and visa processing — all arranged by an experienced
        team that has guided pilgrims from West Yorkshire for years.
      </p>
    </div>
  </section>

  <div id="package-list">
    <div data-package data-departs={octoberUmrah.departs}>
      <Section>
        <h2 data-animate class="text-2xl sm:text-3xl font-bold text-white mb-8">Umrah Packages</h2>
        <OctoberUmrahPackage />
        <div
          data-animate
          class="mt-6 rounded-3xl border border-white/10 bg-navy-light/50 p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10"
        >
          <div class="flex-1">
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
              Don't want to go in a group?
            </h3>
            <p class="text-white/70 leading-relaxed max-w-2xl">
              Would you rather travel independently, or with just your family and friends? Not a
              problem. We'll build your Umrah around you — your dates, your hotels, your pace — and
              take care of the flights, visas and transfers, so all that's left for you is the journey
              itself.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <WhatsAppButton />
            <a
              href="/contact"
              class="inline-flex rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-colors"
            >
              Send an Enquiry
            </a>
          </div>
        </div>
      </Section>
    </div>

    <div data-package data-departs={hajj2027.departs}>
      <Section class="bg-navy-light/30">
        <h2 data-animate class="text-2xl sm:text-3xl font-bold text-white mb-6">Hajj 2027 Packages</h2>
        <HajjDeadline class="mb-6" />
        <Hajj2027Packages />
      </Section>
    </div>
  </div>

  <div id="packages-empty" hidden>
    <Section>
      <div
        data-animate
        class="rounded-3xl border border-white/10 bg-navy-light/50 px-6 sm:px-12 py-12 sm:py-16 text-center"
      >
        <p class="text-teal font-semibold uppercase text-sm tracking-wide mb-3">Coming Soon</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">New packages on the way</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-8 leading-relaxed">
          Our next Hajj and Umrah dates are being finalised. Message us and we'll let you know the
          moment they're announced. We can also build a bespoke Umrah around your own dates.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <WhatsAppButton />
          <a
            href="/contact"
            class="inline-flex rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-colors"
          >
            Send an Enquiry
          </a>
        </div>
      </div>
    </Section>
  </div>

  <script>
    // Pages are prerendered, so order upcoming packages by departure and drop
    // any whose departure has passed, client-side.
    const list = document.getElementById("package-list");
    if (list) {
      const now = Date.now();
      const items = Array.from(list.querySelectorAll<HTMLElement>("[data-package]")).sort(
        (a, b) => Date.parse(a.dataset.departs ?? "") - Date.parse(b.dataset.departs ?? "")
      );
      for (const el of items) {
        if (now >= Date.parse(el.dataset.departs ?? "")) el.remove();
        else list.appendChild(el);
      }
      if (!list.querySelector("[data-package]")) {
        const empty = document.getElementById("packages-empty");
        if (empty) empty.hidden = false;
      }
    }
  </script>

  <Section>
    <div data-animate class="rounded-3xl bg-navy-light border border-white/10 px-6 sm:px-12 py-10 sm:py-14 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Not Sure Which Package Fits?</h2>
      <p class="text-white/70 max-w-xl mx-auto mb-8">
        Every group and family is different. Speak to our team and we'll put together a package
        and payment plan around your needs.
      </p>
      <a
        href={site.phoneHref}
        class="inline-flex rounded-full bg-teal px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
      >
        Call {site.phone}
      </a>
    </div>
  </Section>
</Layout>
