---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { site } from "../data/site";
---

<Layout title="About Us" description="About Heckmondwike Travel & Tours, your local travel agent in West Yorkshire.">
  <section class="bg-navy pt-16 pb-12 sm:pt-24 sm:pb-16 px-4 sm:px-6 text-center">
    <div data-animate-group>
      <h1 data-animate class="text-4xl sm:text-5xl font-extrabold text-white mb-4">About Us</h1>
      <p data-animate class="text-white/70 max-w-2xl mx-auto">{site.tagline}</p>
    </div>
  </section>

  <Section>
    <div class="grid lg:grid-cols-2 gap-10 items-center" data-animate-group>
      <div data-animate class="rounded-2xl overflow-hidden aspect-video bg-navy-light">
        <img src="/images/opening-day.png" alt="Heckmondwike Travel & Tours grand opening" class="h-full w-full object-cover" />
      </div>
      <div data-animate>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Your Local Travel Experts</h2>
        <p class="text-white/70 mb-4">
          Based on Oldfield Lane in Heckmondwike, we're a family-run travel agency serving the
          local community with flights, holidays, and Hajj & Umrah packages. We pride ourselves on
          honest advice, competitive prices, and a personal service you won't get from a
          faceless booking website.
        </p>
        <p class="text-white/70">
          Whether you're visiting family in Pakistan, heading on a Hajj or Umrah pilgrimage, or
          booking a family holiday abroad, our team is here to help — in person, on the phone, or
          on WhatsApp.
        </p>
      </div>
    </div>
  </Section>
</Layout>
