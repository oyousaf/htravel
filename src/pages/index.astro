---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import DestinationCard from "../components/DestinationCard.astro";
import ExchangeRate from "../components/ExchangeRate.tsx";
import Testimonials from "../components/Testimonials.astro";
import LiveFlights from "../components/LiveFlights.tsx";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { destinations } from "../data/destinations";
import { site } from "../data/site";
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy pt-16 pb-20 sm:pt-24 sm:pb-28 px-4 sm:px-6">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(63,217,199,0.15),transparent_60%)]"></div>
    <div class="relative mx-auto max-w-6xl grid lg:grid-cols-2 gap-12 items-center" data-animate-group>
      <div data-animate>
        <p class="text-teal font-semibold tracking-wide uppercase text-sm mb-4">
          Heckmondwike's Trusted Travel Agent
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight">
          Turning Dreams <span class="text-teal">Into Memories</span>
        </h1>
        <p class="mt-6 text-white/70 text-lg max-w-xl">
          Flights, holidays, and Hajj & Umrah packages tailored for you — booked in person at our
          Oldfield Lane office or over the phone.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="rounded-full bg-teal px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
          >
            Get a Free Quote
          </a>
          <WhatsAppButton />
        </div>
      </div>

      <div data-animate>
        <ExchangeRate client:load />
      </div>
    </div>
  </section>

  <!-- Services -->
  <Section>
    <div class="text-center mb-12" data-animate>
      <h2 class="text-3xl sm:text-4xl font-bold text-white">What We Offer</h2>
      <p class="text-white/60 mt-2">Everything for your next journey, under one roof.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {
        [
          { title: "Flight Bookings", desc: "Best-value fares to Pakistan, the Gulf, and worldwide." },
          { title: "Holiday Packages", desc: "All-inclusive family holidays and city breaks." },
          { title: "Hajj & Umrah", desc: "Guided packages with trusted, experienced group leaders." },
          { title: "Visa Assistance", desc: "Support with visa applications and documentation." },
          { title: "Cargo Services", desc: "Sending parcels back home? We accept cargo every Wednesday." },
        ].map((s) => (
          <div data-animate class="rounded-2xl bg-navy-light/50 border border-white/10 p-6">
            <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
            <p class="text-white/60 text-sm">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Live flights -->
  <Section class="pt-0">
    <div class="grid lg:grid-cols-2 gap-6 items-center">
      <div data-animate>
        <h3 class="text-lg font-bold text-white mb-1">Curious what's flying overhead?</h3>
        <p class="text-white/60 text-sm">
          A live look at air traffic over the UK right now — just for fun, powered by public flight-tracking data.
        </p>
      </div>
      <div data-animate>
        <LiveFlights client:load />
      </div>
    </div>
  </Section>

  <!-- Hajj & Umrah highlight -->
  <Section class="bg-navy-light/30">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div data-animate>
        <p class="text-teal font-semibold uppercase text-sm tracking-wide mb-3">Hajj & Umrah</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Sacred Journeys, Handled With Care
        </h2>
        <p class="text-white/70 mb-6">
          From economy Umrah trips to full-service VIP Hajj packages, our experienced team takes
          care of flights, accommodation, transfers, and visas — so you can focus on your
          pilgrimage.
        </p>
        <a
          href="/packages/hajj-umrah"
          class="inline-flex rounded-full bg-teal px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-teal-dark transition-colors"
        >
          View Hajj & Umrah Packages
        </a>
      </div>
      <div data-animate class="relative rounded-2xl overflow-hidden aspect-video bg-navy-light">
        <!--
          Temporary photos (free Unsplash License, commercial use OK, attribution
          optional), fused into one panel along a shared diagonal cut (both the
          images and the divider clip to the same polygon, so they actually meet):
          - Masjid al-Haram, Mecca by Haidan: https://unsplash.com/photos/KbtfseYfgaE
          - Masjid an-Nabawi green dome, Madinah by Sam Riz: https://unsplash.com/photos/FDmr11vM_Ow
          Swap for the client's own photo(s) once available — simplest is a single
          image at public/images/hajj-umrah-hero.jpg replacing this whole block.
        -->
        <div
          class="absolute inset-0 overflow-hidden"
          style="clip-path: polygon(0 0, 54% 0, 46% 100%, 0 100%);"
        >
          <img
            src="https://images.unsplash.com/photo-1513072064285-240f87fa81e8?auto=format&fit=crop&w=1200&q=80"
            alt="The Kaaba at Masjid al-Haram, Mecca"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
            style="object-position: 50% 60%; transform: scale(1.5) translateX(-24%);"
          />
        </div>
        <div
          class="absolute inset-0 overflow-hidden"
          style="clip-path: polygon(54% 0, 100% 0, 100% 100%, 46% 100%);"
        >
          <img
            src="https://images.unsplash.com/photo-1692977579997-948328cdb7d2?auto=format&fit=crop&w=1200&q=80"
            alt="The green dome of Masjid an-Nabawi, Madinah"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
            style="transform: scale(1.3) translateX(22%);"
          />
        </div>
        <div
          class="absolute inset-0 bg-linear-to-b from-teal to-amber-400 shadow-[0_0_12px_rgba(63,217,199,0.5)]"
          style="clip-path: polygon(53% 0, 55% 0, 47% 100%, 45% 100%);"
        ></div>
        <div class="absolute inset-0 bg-linear-to-t from-navy-dark/50 via-transparent to-transparent"></div>
      </div>
    </div>
  </Section>

  <!-- Destinations -->
  <Section>
    <div class="flex items-end justify-between mb-10 flex-wrap gap-4" data-animate>
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Popular Destinations</h2>
        <p class="text-white/60 mt-2">A few of our most-booked routes.</p>
      </div>
      <a href="/destinations" class="text-teal font-semibold text-sm hover:text-teal-dark transition-colors">
        View all destinations →
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
      {destinations.map((d) => <DestinationCard destination={d} />)}
    </div>
  </Section>

  <!-- Testimonials -->
  <Section class="bg-navy-light/30">
    <div class="mb-10" data-animate>
      <h2 class="text-3xl sm:text-4xl font-bold text-white">What Our Customers Say</h2>
      <p class="text-white/60 mt-2">Real reviews from real trips.</p>
    </div>
    <Testimonials />
  </Section>

  <!-- CTA -->
  <Section>
    <div data-animate class="rounded-3xl bg-teal text-navy-dark px-6 sm:px-12 py-12 sm:py-16 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Ready to Plan Your Trip?</h2>
      <p class="text-navy-dark/80 max-w-xl mx-auto mb-8">
        Call, WhatsApp, or visit us in Heckmondwike — our team is ready to find you the best deal.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={site.phoneHref} class="rounded-full bg-navy-dark px-6 py-3 text-sm font-semibold text-white hover:bg-navy transition-colors">
          Call {site.phone}
        </a>
        <WhatsAppButton />
        <a href="/contact" class="rounded-full border border-navy-dark px-6 py-3 text-sm font-semibold text-navy-dark hover:bg-navy-dark hover:text-white transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </Section>
</Layout>
